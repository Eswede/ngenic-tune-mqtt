# Copy to ngenic.env, fill in your values and run: chmod 600 ngenic.env
# Personal access token: https://developer.ngenic.se (Get access token)
NGENIC_TOKEN=

# MQTT broker. NOT localhost unless the broker runs in the same container network.
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Optional overrides (defaults are baked into the Dockerfile)
# POLL_INTERVAL=300
# API_MIN_INTERVAL=1
# MQTT_CLIENT_ID=ngenic-mqtt-poller
# DISCOVERY_PREFIX=homeassistant
